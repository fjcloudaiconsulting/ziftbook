# Local dev (`make up`) needs no .env: docker-compose.yaml sets every variable itself.
#
# This file is for docker-compose-prod.yaml, which reads a .env next to it:
#   cp .env.example .env   # then fill in the blanks below
#   ZIF_IMAGE_TAG=vX.Y.Z docker compose -f docker-compose-prod.yaml up -d
#
# Every variable and its default, required-in-production and secret status: CONTRIBUTING.md,
# "Environment variables" table. A secret is left blank here and never committed; in a real
# deployment it comes from Secrets Manager, not this file.

# Release tag for the three GHCR images (required).
ZIF_IMAGE_TAG=change-me

# --- Database (all required) ---
# Left blank on purpose: docker-compose-prod.yaml refuses to start until each is set.
ZIF_POSTGRES_PASSWORD=
ZIF_MIGRATE_PASSWORD=
ZIF_APP_PASSWORD=
ZIF_WORKER_PASSWORD=

# --- Security ---
# Public web URL, used in email links and Stripe's onboarding return and Apple Pay domain (required in production).
ZIF_APP_URL=https://example.com
# Cloudflare Turnstile secret. Unset refuses every public booking (the compose file has no opt-out).
ZIF_TURNSTILE_SECRET=
# Cloudflare Turnstile site key (optional; set both this and ZIF_TURNSTILE_SECRET, or neither).
ZIF_TURNSTILE_SITE_KEY=
# Show the version line in the console and booking footer (staging only).
ZIF_SHOW_VERSION=
# true enforces the pages' Content-Security-Policy; unset only reports what it would block (ZB-12).
# Enforce once a booking with a card and Turnstile and an admin sign-in show no violations.
ZIF_CSP_ENFORCE=
# Emergency switch: true sends the booking, checkout, manage, invite and account pages' policy report-only
# again (they enforce it whatever ZIF_CSP_ENFORCE says), should it ever block a payment or Turnstile.
ZIF_CSP_PERSONAL_REPORT_ONLY=
# An https URL for CSP violation reports (ZIF-236). Unset: violations show only in the browser's console.
ZIF_CSP_REPORT_URL=
# First-run setup token, 32+ characters (e.g. openssl rand -base64 32). Unset or shorter refuses
# setup; it can be removed once setup is done.
ZIF_SETUP_TOKEN=
# Platform admins' TOTP key: base64 of 32 random bytes (openssl rand -base64 32). Unset or invalid:
# admin TOTP is refused (recovery codes still work). Losing it means every admin re-enrols.
ZIF_TOTP_KEY=
# Pepper for rate-limit keys (ZB-25), 32+ characters (openssl rand -base64 32). Unset or shorter:
# keys hold plain hashes and addresses and the API logs a WARNING. Changing it restarts every counter.
ZIF_RATE_LIMIT_KEY=

# Stripe Connect (ZIF-158). Unset (any of the three): payments off, booking pages take no payment step.
ZIF_STRIPE_SECRET_KEY=
ZIF_STRIPE_WEBHOOK_SECRET=
ZIF_STRIPE_PUBLISHABLE_KEY=

# --- Mail (Mailgun HTTP API; secret left blank) ---
ZIF_MAILGUN_API_KEY=
# The sending domain, e.g. m.example.com.
ZIF_MAILGUN_DOMAIN=
# Optional: eu (default) or us.
ZIF_MAILGUN_REGION=

# --- Optional ---
# ZIF_HEALTHCHECK_URL=
# ZIF_LOG_LEVEL=INFO
# ZIF_LOG_FORMAT=json
# ZIF_LOG_SQL=false

# --- Observability (OpenTelemetry; see CONTRIBUTING.md, Observability) ---
# Traces and metrics go over OTLP/HTTP to this collector endpoint. Unset = both off.
# ZIF_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.example.com/otlp
# Collector auth, URL-encoded key=value pairs (a secret).
# ZIF_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instance:token>
# Standard OTel sampler; always_off stops traces with the endpoint still set.
# ZIF_OTEL_TRACES_SAMPLER=parentbased_traceidratio
# ZIF_OTEL_TRACES_SAMPLER_ARG=0.1
# Turns traces off with the endpoint still set (metrics keep going).
# ZIF_OTEL_TRACES_EXPORTER=none
# Turns metrics off with the endpoint still set (traces keep going).
# ZIF_OTEL_METRICS_EXPORTER=none
