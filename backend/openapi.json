  "components": {
    "schemas": {
      "AuditEventOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "actor_user_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor User Id"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "action",
          "actor_user_id",
          "target",
          "ip",
          "user_agent"
        ],
        "title": "AuditEventOut"
      },
      "BusinessSettings-Input": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Amsterdam"
          },
          "auto_confirm": {
            "type": "boolean",
            "title": "Auto Confirm",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BusinessSettings"
      },
      "BusinessSettings-Output": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Amsterdam"
          },
          "auto_confirm": {
            "type": "boolean",
            "title": "Auto Confirm",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timezone",
          "auto_confirm"
        ],
        "title": "BusinessSettings"
      },
      "CompleteReset": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "CompleteReset"
      },
      "CompleteSignUp": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "business_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Business Name"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password",
          "business_name"
        ],
        "title": "CompleteSignUp"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Error": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Error",
        "description": "Every API error body: a stable code the web app translates, never prose."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "LinkRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "nl",
              "pt"
            ],
            "title": "Locale"
          }
        },
        "type": "object",
        "required": [
          "email",
          "locale"
        ],
        "title": "LinkRequest"
      },
      "SessionOut": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "business_name": {
            "type": "string",
            "title": "Business Name"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "tenant_id",
          "role",
          "email",
          "business_name"
        ],
        "title": "SessionOut"
      }
    }
  }
