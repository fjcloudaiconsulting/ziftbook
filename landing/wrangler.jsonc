{
  "name": "ziftbook-landing",
  // Not a secret: account IDs identify an account but grant no access. The API token is the only secret.
  "account_id": "fb5eb042529f2621c6de3f34c6801174",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request hits worker.js first so www and plain http are redirected on every path, not just "/".
    "run_worker_first": true
  },
  // No routes on purpose (INFRA-113): the custom domains ziftbook.com and www.ziftbook.com stay attached in the
  // Cloudflare dashboard, owner-held. A deploy then leaves them alone, so the CI token can be an Editor scoped to
  // this Worker alone (custom domains and routes need zone-level permissions). Re-adding "routes" here breaks the
  // deploy with that token.
  // Without routes wrangler turns workers.dev on by default; keep it and preview URLs off so the Worker is public
  // only on the custom domains.
  "workers_dev": false,
  "preview_urls": false
}
