#!/bin/sh
# Enforce Conventional Commits on the subject line. release-please builds the changelog from these.
# The real gate is the PR-title check in CI (squash merges make the title the commit); this is fast local feedback.
subject=$(head -n 1 "$1")
case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac
if printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
  exit 0
fi
echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(api): add health endpoint'" >&2
echo "  got: $subject" >&2
exit 1
