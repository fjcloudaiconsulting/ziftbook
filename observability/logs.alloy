// Ships this compose project's container logs to the shared local Loki (make observe, ZIF-90).
// Traces go straight from each process to the same stack over OTLP; this only covers stdout.

discovery.docker "project" {
  host = "unix:///var/run/docker.sock"
  // Only this compose project, never other projects' containers on the same daemon.
  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
  }
}

// service_name matches each process's OTEL_SERVICE_NAME, so Grafana joins a log line to its trace.
discovery.relabel "project" {
  targets = discovery.docker.project.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
    replacement   = "ziftbook-$1"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "backend"
    target_label  = "service_name"
    replacement   = "ziftbook-api"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "frontend"
    target_label  = "service_name"
    replacement   = "ziftbook-web"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "migrate"
    target_label  = "service_name"
    replacement   = "ziftbook-migrations"
  }
}

loki.source.docker "project" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.project.output
  forward_to = [loki.write.lgtm.receiver]
}

loki.write "lgtm" {
  endpoint {
    url = "http://host.docker.internal:3100/loki/api/v1/push"
  }
}
