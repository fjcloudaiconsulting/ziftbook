{
  "name": "ziftbook-web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-ts -s",
    "dev": "openapi-ts -s && next dev",
    "build": "openapi-ts -s && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "openapi-ts -s && next typegen && tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@stripe/stripe-js": "10.2.1",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  }
}
