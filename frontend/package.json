{
  "name": "ziftbook-web",
  "private": true,
  "scripts": {
    "generate": "openapi-ts -s",
    "dev": "openapi-ts -s && next dev",
    "build": "openapi-ts -s && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "openapi-ts -s && next typegen && tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "next": "16.3.5",
    "next-intl": "4.14.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  }
}
